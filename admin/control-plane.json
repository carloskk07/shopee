{
  "schema": "freedom-control-plane-v2",
  "version": "2.2.0",
  "site": "https://achadostube.com.br",
  "repository": "carloskk07/shopee",
  "ownerLogin": "carloskk07",
  "publishing": {
    "branchPrefix": "control-center/",
    "maxFilesPerChangeSet": 12,
    "releaseHashing": "sha256",
    "directMainWrites": false,
    "requireSummary": true
  },
  "security": {
    "sessionOnlyCredentials": true,
    "blockedPrefixes": [
      ".github/",
      "admin/",
      ".git/"
    ],
    "blockedFiles": [
      "release.json"
    ],
    "editableExtensions": [
      ".html",
      ".json",
      ".xml",
      ".txt",
      ".css",
      ".md"
    ],
    "criticalPaths": [
      "index.html",
      "404.html",
      "robots.txt",
      "sitemap.xml",
      "site-data.generated.json",
      "monetization.json"
    ]
  },
  "seo": {
    "ctrOpportunity": {
      "minImpressions": 30,
      "maxPosition": 10,
      "maxCtrPct": 2
    },
    "strikingDistance": {
      "minImpressions": 20,
      "minPosition": 8,
      "maxPosition": 20
    },
    "newIntentReview": {
      "minImpressions": 50,
      "maxSimilarity": 0.25
    },
    "cannibalization": {
      "minTotalImpressions": 20,
      "secondPageShare": 0.2
    }
  },
  "decisionPolicy": {
    "schema": "freedom-closed-loop-policy-v1",
    "mode": "human-approved",
    "objectives": [
      {
        "id": "qualified-organic-discovery",
        "weight": 50,
        "label": "Descoberta orgânica qualificada"
      },
      {
        "id": "book-discovery",
        "weight": 30,
        "label": "Descoberta dos livros e páginas editoriais"
      },
      {
        "id": "conversion-without-dark-patterns",
        "weight": 20,
        "label": "Conversão sem padrões artificiais de atenção"
      }
    ],
    "minimumClusterImpressions": 10,
    "maxConcurrentSeoExperiments": 1,
    "requireFinalizedDataThroughDecisionDate": true,
    "requireEqualPrePostWindows": true,
    "onePrimaryHypothesisPerChangeSet": true,
    "autoMerge": false,
    "directProductionMutation": false,
    "verdicts": [
      "KEEP",
      "ITERATE",
      "REVERT",
      "INCONCLUSIVE"
    ]
  },
  "monetizationPolicy": {
    "schema": "freedom-monetization-intelligence-policy-v1",
    "mode": "human-approved-progressive",
    "demandAuthority": "gsc-finalized",
    "interactionAuthority": "consent-gated-analytics",
    "revenueAuthority": "netlify-private-ledger",
    "missingRevenueSemantics": "UNKNOWN_NOT_ZERO",
    "noImplicitFxConversion": true,
    "acquisitionFirstWhenNoClicks": true,
    "maxActiveSpecificOffersPerPage": 1,
    "autoChannelActivation": false,
    "adsRequireExplicitApproval": true,
    "channels": [
      "SUPPORT",
      "AFFILIATE",
      "KDP",
      "PREMIUM",
      "ADS"
    ]
  },
  "experiments": [
    {
      "id": "o-peso-html-vs-pdf-2026-09",
      "name": "O Peso — HTML vs PDF",
      "status": "OBSERVING",
      "objective": "SHIFT_DISCOVERY_TO_HTML_WITHOUT_CLUSTER_HARM",
      "startedAt": "2026-09-09",
      "minimumDecisionDate": "2026-09-16",
      "targetHtml": "https://achadostube.com.br/o-peso-de-ser-forte-o-tempo-todo",
      "targetPdf": "https://achadostube.com.br/ebook/o-peso-de-ser-forte-o-tempo-todo.pdf",
      "queryContains": [
        "o peso de ser forte",
        "o peso de ser tudo",
        "livro o peso"
      ],
      "successCriteria": {
        "minClusterImpressions": 10,
        "htmlImpressionsMin": 3,
        "minTrafficRatio": 0.65,
        "hardTrafficRatio": 0.5,
        "maxPositionRegression": 2
      },
      "decisionRule": "Preserve attribution until finalized GSC includes the full minimum decision date; compare equal pre/post daily windows and prefer the HTML landing only when it earns title-intent impressions without material cluster harm."
    }
  ],
  "bookPublishing": {
    "enabled": true,
    "templateSlug": "proposito-maior",
    "author": "Arthur Magnus",
    "requiredTags": 3,
    "maxTags": 8,
    "cover": {
      "maxInputBytes": 8388608,
      "maxOutputWidth": 1200,
      "minWidth": 600,
      "minHeight": 800,
      "webpQuality": 0.9
    },
    "pdf": {
      "maxBytes": 26214400
    },
    "paths": {
      "coverPrefix": "assets/covers/capa-",
      "pdfPrefix": "ebook/"
    },
    "bundleFiles": 10,
    "binaryPersistence": "memory-only"
  },
  "quality": {
    "scoreModel": "technical-normalized-v1",
    "searchEvidenceScoring": false,
    "historicalRunsScoring": false,
    "requiredWorkflows": [
      "Site integrity",
      "Admin integrity",
      "Production smoke",
      "Admin production smoke",
      "pages build and deployment"
    ],
    "optionalWorkflows": [
      "Route integrity",
      "Route production smoke"
    ]
  },
  "knowledge": {
    "enabled": true,
    "schema": "freedom-knowledge-layer-v1",
    "publicArtifact": "admin/knowledge.json",
    "runtime": "admin/knowledge-layer.js",
    "privateSearchEvidence": "netlify-private-blobs",
    "browserHydration": "session-only",
    "scheduledSync": "daily",
    "repositoryPersistence": false
  }
}
